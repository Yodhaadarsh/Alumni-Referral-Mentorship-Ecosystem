PORT=5000
CLIENT_URL=http://localhost:5173
# Leave MONGO_URI empty to use the built-in database (nothing to install; data is saved in server/data).
# Or paste a MongoDB Atlas / local connection string, for example:
# MONGO_URI=mongodb://127.0.0.1:27017/alumni_ecosystem
MONGO_URI=mongodb://127.0.0.1:27017/alumni_ecosystem
JWT_SECRET=change_this_to_any_long_random_text
# Optional: Firebase push notifications and Google Meet links (see README)
FIREBASE_SERVICE_ACCOUNT={}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
